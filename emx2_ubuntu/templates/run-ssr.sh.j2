#!/bin/bash

# Assigning the EMX2 version argument
emx2_version="$1"

# Docker command to run the SSR Catalogue container with the EMX2 version
docker container stop catalogue
docker container rm catalogue
docker run -d --restart unless-stopped --network host \
--env NUXT_PUBLIC_API_BASE=https://{{ domain_name }}/ \
--env NUXT_PUBLIC_EMX2_THEME=molgenis \
--env NUXT_PUBLIC_SCHEMA=catalogue \
--name catalogue \
molgenis/ssr-catalogue:"$emx2_version"
